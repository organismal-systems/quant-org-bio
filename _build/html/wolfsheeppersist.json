"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"enumerator":"1","key":"fCQmuIRchX"},{"type":"text","value":", a ","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"oqnNkctHiZ"},{"type":"link","url":"/pdes","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"text","value":"Partial Differential Equation (PDE)","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"DrLSt4n0IR"}],"urlSource":"../../../content/appendix/MathSum/pdes.md","dataUrl":"/pdes.json","internal":true,"protocol":"file","key":"hDO7EYtmLK"},{"type":"text","value":" model that is deterministic and continuous in time, space and population","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"vOyLz5PsBA"}],"key":"NeCYPVjiRY"}],"key":"WCdwS3tsia"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"an ","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"EHzADreXhm"},{"type":"link","url":"https://en.wikipedia.org/wiki/Agent-based_model","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"children":[{"type":"text","value":"agent-based model","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"c4ojV5h1vc"}],"urlSource":"wiki:Agent-based_model","data":{"page":"Agent-based_model","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"rxogDQPKrG"},{"type":"text","value":" that is stochastic and discrete in time, space and popultion","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"lfK6z2rmvI"}],"key":"JNftyUcuCr"}],"key":"jrH2Gzhjfg"}],"key":"llfzn4jlfF"},{"type":"paragraph","position":{"start":{"line":20,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Both of these models are highly simplified compared to real-world populations.\nNonetheless, they illustrate how population dynamics are affected by scaling rules that are common not only to these very different models but also to organisms in nature.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"ZnoHZqbIbv"}],"key":"p3d0SKfq4h"},{"type":"paragraph","position":{"start":{"line":23,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"The first part of this Unit uses scaling analysis to derive a “back-of-the-envelope” estimate for the minimum habitat size that can support a viable population in the KISS model.\nBecause the KISS model can be solved analytically, its exact solution is compared to the generic predictions from scaling analysis.\nFor those interested in understanding how models of this type are solved, a brief derivation of the solution is shown ","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"nvrxjQLjcQ"},{"type":"link","url":"/kisssoln","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"children":[{"type":"text","value":"here","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"j1T6iNg9Fz"}],"urlSource":"./KISSsoln.md","dataUrl":"/kisssoln.json","internal":true,"protocol":"file","key":"G5orVBLLuG"},{"type":"text","value":".","position":{"start":{"line":23,"column":1},"end":{"line":23,"column":1}},"key":"gwjngUkuAg"}],"key":"lXzFgJhUNn"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"The second part of the Unit is an Activity, in which you will analyze demography from an agent-based model implemented in ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"YrUMBEEP4C"},{"type":"link","url":"https://mesa.readthedocs.io/latest/","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"Mesa","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"Oti7FbJ6FH"}],"urlSource":"https://mesa.readthedocs.io/latest/","key":"gXintzFF6i"},{"type":"text","value":" as if it were a real-world population.\nLike the analysis of a small population in the wild, you will have to use some judgement to estimate “characteristic” values for some parameters from simulations in small habitats.\nFrom those parameters, you will estimate the habitat size necessary to maintain stable populations.\nUnlike the real world, you can easily test you predictions by running simulations on larger domains.","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"NuBpC1rcSr"}],"key":"rrvQBTfmF8"},{"type":"footnoteDefinition","identifier":"kiss","label":"kiss","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":32,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"This model is due to Kierstead, Slobodkin and Skellam:","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"JwfeZEyE8L"},{"type":"break","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"FhOx5deQgX"},{"type":"text","value":"Kierstead, H.; Slobodkin, L.B. The Size of Water Masses Containing Plankton Bloom. J. Mar. Res. 1953, 12, 141–147.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"zjS9F3Ksiw"},{"type":"break","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"X8mSrqq0xJ"},{"type":"text","value":"Skellam, J.G. Random Dispersal in theoretical biology. Bull. Math. Biol. 1991, 53, 135–165; Reprinted from Biometrika 1951, 38,\n196–218.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"a8SaSYC53n"}],"key":"villRuwnN1"}],"enumerator":"1","key":"dUSrmGQIwW"}],"key":"ldxRxqFboZ"}],"key":"FK4EaNmzKz"},"references":{"cite":{"order":[],"