ersist-1.json","internal":true,"protocol":"file","key":"yq4kyLcZkn"},{"type":"text","value":" implements a modified version of an agent-based model, developed in the Python package ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"U8AsaloRAn"},{"type":"link","url":"https://mesa.readthedocs.io/latest/","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Mesa","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"UGNt66PqLB"}],"urlSource":"https://mesa.readthedocs.io/latest/","key":"MJOPfWtLro"},{"type":"text","value":", called the ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"aTWSDfOaqe"},{"type":"link","url":"https://mesa.readthedocs.io/latest/examples/advanced/wolf_sheep.html","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"Wolf-Sheep Predation Model","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"F2ezf2YtML"}],"urlSource":"https://mesa.readthedocs.io/latest/examples/advanced/wolf_sheep.html","key":"fZuB0nsMDM"},{"type":"text","value":".\nThis model is based on an earlier, similar model implemented in the agent-based modeling platform ","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"RjqbANTRF3"},{"type":"link","url":"https://www.netlogo.org/","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"children":[{"type":"text","value":"NetLogo","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"OKXb7zw1Eb"}],"urlSource":"https://www.netlogo.org/","key":"Fj7hbdkAZo"},{"type":"text","value":".\nBoth these models are intentionally simplistic, and, even aside from lacking species-specific characteristics of wolves and sheep, have rules that do not correspond to nature.","position":{"start":{"line":2,"column":1},"end":{"line":2,"column":1}},"key":"foe8xlhUD9"}],"key":"KpTl4QnOUV"},{"type":"paragraph","position":{"start":{"line":6,"column":1},"end":{"line":8,"column":1}},"children":[{"type":"text","value":"Nonetheless, these models illustrate important aspects of population dynamics involving three trophic levels.\nIn particular, they highlight the importance of stochasticity – random occurences – that are “assumed out” of most PDE models.\nIn this respect, even relatively detailed PDE models can give results that are more misleading and difficult to interpret than simplistic agent-based models.","position":{"start":{"line":6,"column":1},"end":{"line":6,"column":1}},"key":"s8ysqqvRpV"}],"key":"TGAwsl84YE"},{"type":"heading","depth":2,"position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"children":[{"type":"text","value":"Key attributes of the agent-based model","position":{"start":{"line":10,"column":1},"end":{"line":10,"column":1}},"key":"akkr2OD3fe"}],"identifier":"key-attributes-of-the-agent-based-model","label":"Key attributes of the agent-based model","html_id":"key-attributes-of-the-agent-based-model","implicit":true,"key":"wVKIDUDcCD"},{"type":"paragraph","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"children":[{"type":"text","value":"The most important attributes of the Wolf-Sheep model for the purpose of this Activity are:","position":{"start":{"line":11,"column":1},"end":{"line":11,"column":1}},"key":"zphABRmTYi"}],"key":"D1Z7ZStHgM"},{"type":"list","ordered":true,"start":1,"spread":false,"position":{"start":{"line":12,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":12,"column":1},"end":{"line":13,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The agents inhabit a so-called  “torus”, where if they move off the right boundary of the grid they reappear on the left boundary, and ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"zHQ0mPsxF1"},{"type":"emphasis","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"vice versa","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"uRfasjR8MA"}],"key":"NycTI7oofG"},{"type":"text","value":".\nLikewise, if they move off the upper boundary they reappear on the bottom boundary, and ","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"N3xGjIYgMG"},{"type":"emphasis","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"children":[{"type":"text","value":"vice versa","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"eFnch6pMh5"}],"key":"PW4l2hBV6x"},{"type":"text","value":".","position":{"start":{"line":12,"column":1},"end":{"line":12,"column":1}},"key":"WVGauHqWAt"}],"key":"mb90yjUp0j"}],"key":"dbX3ZNeJUp"},{"type":"listItem","spread":true,"position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"All events happen at discrete time steps, normalized to 1 time unit.","position":{"start":{"line":14,"column":1},"end":{"line":14,"column":1}},"key":"zRnRs7vIIM"}],"key":"Cvh5KEj9XX"}],"key":"tTk6Z8HisR"},{"type":"listItem","spread":true,"position":{"start":{"line":15,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"The model has three types of agents – grass, sheep and wolves – that follow these rules:","position":{"start":{"line":15,"column":1},"end":{"line":15,"column":1}},"key":"CXjmC8vu5x"}],"key":"Rmecp8HPrh"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":16,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Grass, which grows by itself at a rate set by the user and is consumed by a sheep if it is on the grass patch.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"QNTclGO6mJ"}],"key":"VHkgbPyscV"}],"key":"TsUysxWIKD"},{"type":"listItem","spread":true,"position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Both sheep and wolves move one patch in a random direction at each time step.","position":{"start":{"line":17,"column":1},"end":{"line":17,"column":1}},"key":"Z4GmSULrxk"}],"key":"nFhlIKSFqb"}],"key":"D0JzRx3Ma1"},{"type":"listItem","spread":true,"position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Sheep, gain energy from eating grass if they land on it, consume energy every time step, and are eaten if encountered by wolves.\nSheep reproduce with a constant user-set probability each time step.","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"aAfwfzRdy2"}],"key":"nCfELkKVJV"}],"key":"VdBKbrOeRZ"},{"type":"listItem","spread":true,"position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Wolves, gain energy from eating sheep if they land on one, consume energy every time step, and reproduce with a constant user-set probability each time step.","position":{"start":{"line":20,"column":1},"end":{"line":20,"column":1}},"key":"CqvzwCjRmZ"}],"key":"fxp6T4fpBG"}],"key":"U96a0va781"},{"type":"listItem","spread":true,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"Both sheep and wolves die if they run out of energy.","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"oRboW5mko2"}],"key":"MbI79NIGZn"}],"key":"VB77qaPKXm"}],"key":"LmefWAHPii"}],"key":"d5QJ9sGMdM"},{"type":"listItem","spread":true,"position":{"star