inated?","position":{"start":{"line":28,"column":1},"end":{"line":28,"column":1}},"key":"bFP0IE03uG"}],"key":"Bd3FtKvFPH"}],"key":"wwQMpJdhOG"}],"key":"vvfoBycHV6"},{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"That is, must a large fraction of the population be vaccinated before a significant reduction is seen in cholera cases, or is a lower vaccination rate also effective?","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"szrbOhvO8d"}],"key":"Wh26rp6SIB"},{"type":"heading","depth":2,"position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"Cholera mitigation strategy C: Improve nutrition and basic health","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"hUDT83xEuL"}],"identifier":"cholera-mitigation-strategy-c-improve-nutrition-and-basic-health","label":"Cholera mitigation strategy C: Improve nutrition and basic health","html_id":"cholera-mitigation-strategy-c-improve-nutrition-and-basic-health","implicit":true,"key":"m2TvCIMgs6"},{"type":"paragraph","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"children":[{"type":"text","value":"The duration of immunity after recovery from cholera, ","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"pIdSgcs9LH"},{"type":"inlineMath","value":"t_{immunity","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"error":true,"message":"Expected '}', got 'EOF' at end of input: t_{immunity","key":"sLBn551fic"},{"type":"text","value":", is one of many physiological impacts of nutritional state.","position":{"start":{"line":33,"column":1},"end":{"line":33,"column":1}},"key":"qzhuIqR5uu"}],"key":"htQvIvsIEA"},{"type":"paragraph","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"children":[{"type":"text","value":"A more general but potentially effective approach would be to invest in improving nutrition for the whole population through improvements in agriculture, transportation and food handling.","position":{"start":{"line":35,"column":1},"end":{"line":35,"column":1}},"key":"CHxirrxkzu"}],"key":"mB88HQWaNv"},{"type":"paragraph","position":{"start":{"line":37,"column":1},"end":{"line":39,"column":1}},"children":[{"type":"text","value":"Let’s assume that, because of regional population pressure, the overall nutritional state is decreasing and so, without intervention, the period of immunity will decrease by 25%.\nHowever, with investment, this decrease could be prevented.\nWith even more investment, nutrition could actually improve, increasing the period of immunity by 25%.","position":{"start":{"line":37,"column":1},"end":{"line":37,"column":1}},"key":"e0X9Kwzc0t"}],"key":"d6AqP24sX3"},{"type":"list","ordered":false,"spread":false,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"listItem","spread":true,"position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"children":[{"type":"paragraph","children":[{"type":"text","value":"How effective might these investments be in reducing cholera caseloads?","position":{"start":{"line":40,"column":1},"end":{"line":40,"column":1}},"key":"fIOdLjxICL"}],"key":"NdpRNETyEb"}],"key":"kUnbTNaiqI"}],"key":"xvyYbpLTl0"}],"key":"lk2cIR6T8H"}],"key":"hgAeEwfpYn"},"references":{"cite":{"order":[],"data":{}}},"footer":{"navigation":{"prev":{"title":"🛼  Sensitivity to parameters","url":"/cholera-activities1","group":"Demography"},"next":{"title":"️💡️  A discrete-time model of cholera immune period","url":"/cholera-model","group":"Demography"}}},"domain":"http://localhost:3002"}