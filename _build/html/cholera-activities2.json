>c</span></span></span></span>","key":"IfBym9clLM"},{"type":"text","value":"), climate effects (parameter ","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"GVIOUYV2ct"},{"type":"inlineMath","value":"b","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><mi>b</mi></mrow><annotation encoding=\"application/x-tex\">b</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.6944em;\"></span><span class=\"mord mathnormal\">b</span></span></span></span>","key":"SdQScHSVwj"},{"type":"text","value":"), or some of each.","position":{"start":{"line":16,"column":1},"end":{"line":16,"column":1}},"key":"ShPAZ8fapg"}],"key":"lppmP6iR7F"},{"type":"paragraph","position":{"start":{"line":18,"column":1},"end":{"line":19,"column":1}},"children":[{"type":"text","value":"Which approach would have the biggest impact on reducing cholera cases?\nHow does the effect on case load improve with increasing levels of investment?","position":{"start":{"line":18,"column":1},"end":{"line":18,"column":1}},"key":"fSP52MK88r"}],"key":"jeWC4e2DcZ"},{"type":"heading","depth":2,"position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"children":[{"type":"text","value":"Cholera mitigation strategy B: Vaccinate against cholera","position":{"start":{"line":21,"column":1},"end":{"line":21,"column":1}},"key":"yYIoHLYA7I"}],"identifier":"cholera-mitigation-strategy-b-vaccinate-against-cholera","label":"Cholera mitigation strategy B: Vaccinate against cholera","html_id":"cholera-mitigation-strategy-b-vaccinate-against-cholera","implicit":true,"key":"lviiOnnZTZ"},{"type":"paragraph","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"children":[{"type":"text","value":"Another potential mitigation strategy is vaccination.","position":{"start":{"line":22,"column":1},"end":{"line":22,"column":1}},"key":"BLN6Sm8Qdw"}],"key":"r1zVq2GYEa"},{"type":"paragraph","position":{"start":{"line":24,"column":1},"end":{"line":25,"column":1}},"children":[{"type":"text","value":"Vaccines, because they don’t induce severe disease, sometimes provide a lower level of immunity than actually contracting the disease.\nNonetheless, they typically provide some resistance to getting infected, and especially protection against more severe effects for people who do get infected.","position":{"start":{"line":24,"column":1},"end":{"line":24,"column":1}},"key":"NgotWYEADF"}],"key":"LYZd1QYgdd"},{"type":"paragraph","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"children":[{"type":"text","value":"You can model the effects of vaccinating a given fraction of the population with the parameter ","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"key":"dhnSSMReJ3"},{"type":"inlineMath","value":"f_{vaccinated}","position":{"start":{"line":27,"column":1},"end":{"line":27,"column":1}},"html":"<span class=\"katex\"><span class=\"katex-mathml\"><math xmlns=\"http://www.w3.org/1998/Math/MathML\"><semantics><mrow><msub><mi>f</mi><mrow><mi>v</mi><mi>a</mi><mi>c</mi><mi>c</mi><mi>i</mi><mi>n</mi><mi>a</mi><mi>t</mi><mi>e</mi><mi>d</mi></mrow></msub></mrow><annotation encoding=\"application/x-tex\">f_{vaccinated}</annotation></semantics></math></span><span class=\"katex-html\" aria-hidden=\"true\"><span class=\"base\"><span class=\"strut\" style=\"height:0.8889em;vertical-align:-0.1944em;\"></span><span class=\"mord\"><span class=\"mord mathnormal\" style=\"margin-right:0.10764em;\">f</span><span class=\"msupsub\"><span class=\"vlist-t vlist-t2\"><span class=\"vlist-r\"><span class=\"vlist\" style=\"height:0.3361em;\"><span style=\"top:-2.55em;margin-left:-0.1076em;margin-right:0.05em;\"><span class=\"pstrut\" style=\"height:2.7em;\"></span><span class=\"sizing reset-size