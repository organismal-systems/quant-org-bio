cundity","data":{"page":"Fecundity","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"yJscxolUM8"},{"type":"text","value":" (production of eggs and sperm) as they get bigger.\nTheir ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"BsTwxLcctI"},{"type":"link","url":"https://en.wikipedia.org/wiki/Mortality_rate","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"natural mortality rate","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"nE9waBWKXN"}],"urlSource":"wiki:Mortality_rate","data":{"page":"Mortality_rate","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"RBep7Iuyn4"},{"type":"text","value":"  is very high when they are ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"pT4oLQI081"},{"type":"link","url":"https://en.wikipedia.org/wiki/Ichthyoplankton","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"larvae","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"odA5oVj4Sj"}],"urlSource":"wiki:Ichthyoplankton","data":{"page":"Ichthyoplankton","wiki":"https://en.wikipedia.org/","lang":"en"},"internal":false,"protocol":"wiki","key":"msFsoS12sc"},{"type":"text","value":" and ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"dFUfmFhGDZ"},{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"juveniles","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"wctEdMfs94"}],"key":"VZnGCEjnhw"},{"type":"text","value":".\nOnce they become ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"XZreq1BVcQ"},{"type":"strong","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"adults","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"CcpgM3wVis"}],"key":"KO8vD9jHty"},{"type":"text","value":", however, mortality is much lower and roughly constant between ages 2 and 8 years.\nAs noted, the juveniles and adults are also subject to human-induced mortality from bycatch and targeted fishing, but this fishing pressure is differs in the Gulf ","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"KQhjUgd7ZM"},{"type":"emphasis","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"children":[{"type":"text","value":"vs","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"UxcfC1Nvjg"}],"key":"QY4oN8r5fn"},{"type":"text","value":". the Atlantic in both intensity and the most-impacted age classes.","position":{"start":{"line":32,"column":1},"end":{"line":32,"column":1}},"key":"c1Qq89uYkj"}],"key":"MHtSO7gvhd"},{"type":"paragraph","position":{"start":{"line":38,"column":1},"end":{"line":41,"column":1}},"children":[{"type":"text","value":"Aside from changes in fecundity and mortality across year classes, the first year of a croaker’s life is distinct because during this year it begins as an egg and develops through a sequence of stages into a juvenile and finally into an adult.\nDuring this interval, croakers grow and develop rapidly,  but also suffer very high mortality rates.\nSmall changes in mortality rates during larval and juvenile stages can have big impacts on how many croakers survive to become long-lived, reproducing adults.\nHence, variations in the demography of successive developmental stages during the first year can alter the fate of the entire population.","position":{"start":{"line":38,"column":1},"end":{"line":38,"column":1}},"key":"lstCDwcUUF"}],"key":"OsrcdaWtIl"},{"type":"paragraph","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"cite","url":"doi:10.1139/cjfas-57-10-2010","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"children":[{"type":"text","value":"Diamond ","key":"tAD6894bM3"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"mfvx95EP3l"}],"key":"piDCnN4aZU"},{"type":"text","value":" (2000)","key":"uygZOKJIaN"}],"kind":"narrative","label":"Diamond_2000","identifier":"doi:10.1139/cjfas-57-10-2010","enumerator":"1","key":"iuPkiDpSOS"},{"type":"text","value":" used their model to ask,","position":{"start":{"line":43,"column":1},"end":{"line":43,"column":1}},"key":"gr1Mond0Ii"}],"key":"Th9xa3IWEr"},{"type":"blockquote","position":{"start":{"line":44,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":44,"column":1},"end":{"line":45,"column":1}},"children":[{"type":"text","value":"What are the demographic effects of increased mortality due to targeted and by-catch fishing?","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"dKCRe7zOzl"},{"type":"break","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"uHh0faiKYk"},{"type":"text","value":"How do those effects compare to and interact with natural mortality mechanisms?","position":{"start":{"line":44,"column":1},"end":{"line":44,"column":1}},"key":"a30nxY2ReH"}],"key":"g2VUckOnXR"}],"key":"iemc03usfj"},{"type":"paragraph","position":{"start":{"line":47,"column":1},"end":{"line":48,"column":1}},"children":[{"type":"text","value":"To these, we could add an additional set of questions concerning the evolution of modified life history characteristics in response to anthropogenic changes in selective pressures.\nShould we expect  long-term evolutionary adjustments in croaker life history to mitigate, or perhaps to aggravate, the shorter-term demographic changes?","position":{"start":{"line":47,"column":1},"end":{"line":47,"column":1}},"key":"dfsatyYh8c"}],"key":"sCde3mUkF9"},{"type":"heading","depth":2,"position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"children":[{"type":"text","value":"Egg size evolution","position":{"start":{"line":50,"column":1},"end":{"line":50,"column":1}},"key":"hVzJhPodem"}],"identifier":"egg-size-evolution","label":"Egg size evolution","html_id":"egg-size-evolution","implicit":true,"key":"BOhzljMaTv"},{"type":"paragraph","position":{"start":{"line":51,"column":1},"end":{"line":53,"column":1}},"children":[{"type":"text","value":"Mortality during the croaker’s planktonic phase does not appear to be under direct human control.\nHowever, it may be strongly affected by habitat degradation, pollution, warming and other effects that ","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"eVWPbAFunK"},{"type":"emphasis","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"children":[{"type":"text","value":"are","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"CHq5yINxHn"}],"key":"S90q554Bs9"},{"type":"text","value":" under human control).\nFurthermore, planktonic mortality may be subject to evolutionary changes under the natural selection of life history traits.","position":{"start":{"line":51,"column":1},"end":{"line":51,"column":1}},"key":"v4nDokKcjT"}],"key":"r1zBHYroVK"},{"type":"paragraph","position":{"start":{"line":55,"column":1},"end":{"line":57,"column":1}},"children":[{"type":"text","value":"For example, croakers’ early larval stages are periods of feeding and growth.\nA shift in reproductive strategy towards more resources invested in each egg might result in larvae that require less growth, develop faster, and hence suffer less mortality in the plankton.\nOf course, this would have consequences: a female with given resources could produce fewer eggs if each one is larger.","position":{"start":{"line":55,"column":1},"end":{"line":55,"column":1}},"key":"QCOgNgb5dm"}],"key":"TYf8w6ClN5"},{"type":"paragraph","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"children":[{"type":"text","value":"This raises a number of questions about croaker life history, and by extension the life histories of marine organisms in general:","position":{"start":{"line":59,"column":1},"end":{"line":59,"column":1}},"key":"NaPxRkYyOQ"}],"key":"duNYuJA3X3"},{"type":"blockquote","position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":60,"column":1},"end":{"line":61,"column":1}},"children":[{"type":"text","value":"For a given scenario of mortality and larval duration, what  egg size maximizes the intrinsic rate of increase of a population?","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"vJMIebw5kN"},{"type":"break","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"w830iUAzse"},{"type":"text","value":"What changes in biotic and abiotic environmental characteristics have the strongest effect on ``optimal’’ egg sizes and other life history parameters?","position":{"start":{"line":60,"column":1},"end":{"line":60,"column":1}},"key":"W8jNAFKdVh"}],"key":"B8wfbpkSG8"}],"key":"Jz9nY9nIY7"},{"type":"paragraph","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"In this Activity, we will use ","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"VE8MWkciAs"},{"type":"cite","url":"doi:10.1139/cjfas-57-10-2010","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"text","value":"Diamond ","key":"TxjVzUTmIq"},{"type":"emphasis","children":[{"type":"text","value":"et al.","key":"sOrSy61sWy"}],"key":"dcqgEWxVCL"},{"type":"text","value":" (2000)","key":"bJ54lt1xS0"}],"kind":"narrative","label":"Diamond_2000","identifier":"doi:10.1139/cjfas-57-10-2010","enumerator":"1","key":"C8M0RUo3VM"},{"type":"text","value":" model  to assess the key natural and anthropogenic factors determining the increase or decline of Atlantic croaker populations, and to speculate about possible evolutionary changes in egg sizes.","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"key":"oemBQkCA91"}],"key":"B2BMDbwQYn"},{"type":"footnoteDefinition","identifier":"crk","label":"crk","position":{"start":{"line":63,"column":1},"end":{"line":63,"column":1}},"children":[{"type":"paragraph","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"children":[{"type":"text","value":"(I haven’t followed up with the most recent catch data, but there are published suggestions ocean warming is contributing to increases in croaker stocks.","position":{"start":{"line":30,"column":1},"end":{"line":30,"column":1}},"key":"GNphyF7AyG"}],"key":"xIHHvbI4FZ"}],"enumerator":"1","key":"IwdH13Zn7i"}],"key":"MI8g7z6vGV"}],"key":"vQXzKzTGS2"},"references":{"cite":{"order":["Diamond_2000"],"data":{"Diamond_2000":{"label":"Diamond_2000","enumerator":"1","doi":"10.1139/f00-154","html":"Diamond, S. L., Cowell, L. G., & Crowder, L. B. (2000). Population effects of shrimp trawl bycatch on Atlantic croaker. <i>Canadian Journal of Fisheries and Aquatic Sciences</i>, <i>57</i>(10), 2010–2021. <a target=\"_blank\" rel=\"noreferrer\" href=\"https://doi.org/10.1139/f00-154\">10.1139/f00-154</a>","url":"https://doi.org/10.1139/f00-154"}}}},"footer":{"navigation":{"prev":{"title":"️💡️  A “quota” model of diatom demography","url":"/litchman-etal2009","group":"Demography"},"next":{"title":"📖️ Modeling Croaker demography","url":"/croakermodel","group":"Demography"}}},"domain":"http://localhost:3001"}